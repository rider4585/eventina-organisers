---
const currentYear = new Date().getFullYear();
---

<!-- Global Footer -->
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Column 1: Brand & Philosophy -->
      <div class="footer-brand">
        <a href="/" class="site-logo" aria-label="Eventina Organisers: Return to homepage">
          <svg class="logo-crest" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 3"/>
            <path d="M20 7L24 16L33 20L24 24L20 33L16 24L7 20L16 16L20 7Z" fill="currentColor" opacity="0.9"/>
            <circle cx="20" cy="20" r="2.5" fill="#B89242"/>
          </svg>
          <div class="logo-text-group">
            <span class="logo-brand">Eventina</span>
            <span class="logo-tagline">Organisers</span>
          </div>
        </a>
        <p>
          Curating bespoke celebrations, grand destination weddings, and high-impact corporate galas with uncompromising precision and creative passion across India.
        </p>
        <div class="footer-social-strip" aria-label="Follow Eventina Organisers on social media">
          <a href="https://www.instagram.com/mr.eventina?rpxt=MTVlZ3Vzc3dmcnY4OA==" class="social-icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Eventina on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://www.facebook.com/share/1BzcEcdnkp/?mibextid=wwXIfr" class="social-icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Eventina on Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h2 class="footer-col-title">Company</h2>
        <ul class="footer-nav-list">
          <li><a href="/" class="footer-nav-link">Home</a></li>
          <li><a href="/about" class="footer-nav-link">About Us</a></li>
          <li><a href="/founders" class="footer-nav-link">Founders</a></li>
          <li><a href="/services" class="footer-nav-link">Services</a></li>
          <li><a href="/artists" class="footer-nav-link">Artists</a></li>
          <li><a href="/portfolio" class="footer-nav-link">Portfolio Showcase</a></li>
        </ul>
      </div>

      <!-- Column 3: Experiences -->
      <div>
        <h2 class="footer-col-title">Experiences</h2>
        <ul class="footer-nav-list">
          <li><a href="/events" class="footer-nav-link">Event Formats</a></li>
          <li><a href="/testimonials" class="footer-nav-link">Testimonials & Reviews</a></li>
          <li><a href="/locations" class="footer-nav-link">Locations Map</a></li>
          <li><a href="/blog" class="footer-nav-link">Articles & Stories</a></li>
          <li><a href="/faq" class="footer-nav-link">Frequently Asked Questions</a></li>
          <li><a href="/enquiry" class="footer-nav-link">Enquiry Form</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Hours -->
      <div>
        <h2 class="footer-col-title">Get in Touch</h2>
        <ul class="footer-contact-list">
          <li class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Pune, Maharashtra, India</span>
          </li>
          <li class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span><a href="tel:+919767177776">+91 97671 77776</a> / <a href="tel:+919767277776">+91 97672 77776</a></span>
          </li>
          <li class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <a href="mailto:Eventinapvtltd@gmail.com">Eventinapvtltd@gmail.com</a>
          </li>
          <li class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>Consultations: Mon – Sat, 10:00 AM – 7:30 PM</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Copyright & Legal -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} Eventina Organisers. All rights reserved.
      </p>
      <div class="footer-legal-links">
        <a href="/privacy" class="footer-legal-link">Privacy Policy</a>
        <a href="/terms" class="footer-legal-link">Terms of Use</a>
        <a href="/cookies" class="footer-legal-link">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>
