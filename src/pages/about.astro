---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us | Eventina Organisers — Luxury Event & Wedding Planners"
  description="Discover the story and craft behind Eventina Organisers. We design and produce bespoke destination weddings, corporate galas, and private celebrations with timeless artistry across India."
>
  <!-- Interior Hero Banner -->
  <section class="page-hero" aria-labelledby="about-hero-title">
    <div class="container page-hero-inner">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li aria-current="page">About Us</li>
        </ol>
      </nav>

      <span class="eyebrow">The Story &amp; Ethos of Eventina</span>
      <h1 id="about-hero-title" class="page-hero-title">
        Architects of Emotion, Craftsmen of Grandeur
      </h1>
      <p class="page-hero-lead">
        We bring extraordinary celebrations to life across India — pairing couture visual scenography with the uncompromising precision of luxury hospitality.
      </p>
    </div>
  </section>

  <!-- Company Story & Vision Section -->
  <section class="section" aria-labelledby="story-heading">
    <div class="container">
      <div class="story-split">
        <div class="about-story-text">
          <span class="eyebrow">Who We Are</span>
          <h2 id="story-heading" style="font-size: var(--text-3xl); margin-bottom: var(--space-4);">
            Born in Bengaluru, Celebrated Across Palaces &amp; Destinations
          </h2>
          <p class="about-intro-lead">
            Eventina Organisers was founded on a simple conviction: monumental scale should never compromise emotional intimacy. A royal wedding with eight hundred guests should feel as heartfelt as a candlelit dinner; a high-impact corporate gala should inspire awe without losing its human pulse.
          </p>
          <p>
            Over the past eight years, our studio has expanded from curating distinguished gatherings in Karnataka to orchestrating landmark destination weddings in Udaipur, Jaipur, and Goa, as well as prestigious corporate summits and private soirées across India’s major metropolitan hubs.
          </p>
          <p>
            We operate not as transactional vendors, but as your trusted creative partners. Every fabric drapery, acoustic frequency, floral installation, and lighting cue is orchestrated in harmony — ensuring the hosts can surrender to the moment, completely confident that every detail is moving to an exquisite rhythm.
          </p>

          <div style="margin-top: var(--space-6); display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap;">
            <a href="/portfolio" class="btn btn-secondary">
              <span>View Curated Work</span>
            </a>
            <a href="/founders" class="btn btn-ghost" style="color: var(--color-gold-600);">
              <span>Meet Our Directors &rarr;</span>
            </a>
          </div>
        </div>

        <div class="story-image-composition">
          <img
            src="https://images.unsplash.com/photo-1519741497674-611481863552?w=1000&q=80&auto=format&fit=crop"
            alt="Luxury wedding banquet with chandeliers and opulent floral arrangements curated by Eventina"
            width="1000"
            height="750"
            loading="lazy"
          />
          <div class="story-image-badge" aria-hidden="true">
            <span class="badge-number">8+</span>
            <span class="badge-text">Years of Curatorial Mastery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Differentiators Section -->
  <section class="section about-differentiators-section" aria-labelledby="differentiators-heading">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">Why Discerning Hosts Choose Us</span>
        <h2 id="differentiators-heading">What Sets Eventina Apart</h2>
        <p>Four pillars that define our standards of artistic vision, production discipline, and guest hospitality.</p>
      </div>

      <div class="values-grid">
        <!-- Pillar 1 -->
        <article class="value-card">
          <div class="value-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
          <h3>Couture Scenography</h3>
          <p>Zero recycled templates or generic decor packages. Every aesthetic concept, floral palette, and spatial layout is conceived from scratch to reflect your distinctive heritage and personality.</p>
        </article>

        <!-- Pillar 2 -->
        <article class="value-card">
          <div class="value-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>Military Run of Show</h3>
          <p>A production timeline mapped down to the minute. Backstage audio-visual cues, artist green-room management, and banquet synchronisation operate with quiet, clockwork precision.</p>
        </article>

        <!-- Pillar 3 -->
        <article class="value-card">
          <div class="value-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
          </div>
          <h3>Pan-India Vendor Guild</h3>
          <p>Pre-vetted, direct relationships with premier heritage palaces, master sound engineers, bespoke caterers, and renowned floral botanists across 15+ destination cities.</p>
        </article>

        <!-- Pillar 4 -->
        <article class="value-card">
          <div class="value-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <h3>White-Glove Hospitality</h3>
          <p>Personalized airport meet-and-greets, luxury guest transport logistics, discreet bridal and VIP shadow concierges, and instant round-the-clock family support throughout the celebration.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How We Work Process Strip -->
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">Our Methodology</span>
        <h2 id="process-heading">How We Work: From Vision to Grandeur</h2>
        <p>A rigorous four-stage framework designed to give you complete creative clarity and total peace of mind.</p>
      </div>

      <div class="process-strip">
        <!-- Step 01 -->
        <div class="process-step-card">
          <div class="process-step-header">
            <span class="process-step-num">01</span>
            <span class="process-step-duration">Weeks 1 – 2</span>
          </div>
          <h3 class="process-step-title">Discovery &amp; Creative Curation</h3>
          <p class="process-step-desc">
            We immerse ourselves in your vision, cultural rituals, aesthetic preferences, and budget priorities to establish a bespoke design thesis.
          </p>
          <ul class="process-step-tags" aria-label="Deliverables for stage 1">
            <li class="process-step-tag">Mood Board Concept</li>
            <li class="process-step-tag">Budget Framework</li>
            <li class="process-step-tag">Venue Feasibility</li>
          </ul>
        </div>

        <!-- Step 02 -->
        <div class="process-step-card">
          <div class="process-step-header">
            <span class="process-step-num">02</span>
            <span class="process-step-duration">Weeks 3 – 6</span>
          </div>
          <h3 class="process-step-title">Scenography &amp; Master Blueprint</h3>
          <p class="process-step-desc">
            Our architects translate the creative vision into detailed 3D spatial renders, structural stage drawings, floral mockups, and menu pairings.
          </p>
          <ul class="process-step-tags" aria-label="Deliverables for stage 2">
            <li class="process-step-tag">3D Walkthrough Renders</li>
            <li class="process-step-tag">Lighting &amp; Audio Riders</li>
            <li class="process-step-tag">Vendor Contracts</li>
          </ul>
        </div>

        <!-- Step 03 -->
        <div class="process-step-card">
          <div class="process-step-header">
            <span class="process-step-num">03</span>
            <span class="process-step-duration">Weeks 7 – 10</span>
          </div>
          <h3 class="process-step-title">Technical Orchestration</h3>
          <p class="process-step-desc">
            We run cue-to-cue technical rehearsals, manage artist hospitality riders, synchronize logistics schedules, and finalize permits.
          </p>
          <ul class="process-step-tags" aria-label="Deliverables for stage 3">
            <li class="process-step-tag">Minute-by-Minute Cue Sheet</li>
            <li class="process-step-tag">Guest Concierge Desk</li>
            <li class="process-step-tag">Permits &amp; Compliance</li>
          </ul>
        </div>

        <!-- Step 04 -->
        <div class="process-step-card">
          <div class="process-step-header">
            <span class="process-step-num">04</span>
            <span class="process-step-duration">Live Event</span>
          </div>
          <h3 class="process-step-title">Flawless Live Execution</h3>
          <p class="process-step-desc">
            Our on-ground production command post coordinates every movement, catering course, live artist cue, and guest transfer with invisible perfection.
          </p>
          <ul class="process-step-tags" aria-label="Deliverables for stage 4">
            <li class="process-step-tag">On-Ground Command Desk</li>
            <li class="process-step-tag">Shadow Concierges</li>
            <li class="process-step-tag">Wrap &amp; Reconciliation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- By-The-Numbers Stats Band -->
  <section class="about-stats-band" aria-labelledby="stats-band-heading">
    <div class="container">
      <h2 id="stats-band-heading" class="sr-only">Eventina Performance Metrics &amp; Experience Scale</h2>
      <div class="about-stats-grid">
        <div class="about-stat-box">
          <span class="about-stat-num">500+</span>
          <span class="about-stat-lbl">Celebrations Curated</span>
        </div>
        <div class="about-stat-box">
          <span class="about-stat-num">15+</span>
          <span class="about-stat-lbl">Destination Cities</span>
        </div>
        <div class="about-stat-box">
          <span class="about-stat-num">99%</span>
          <span class="about-stat-lbl">Guest Delight Score</span>
        </div>
        <div class="about-stat-box">
          <span class="about-stat-num">100%</span>
          <span class="about-stat-lbl">On-Time Run of Show</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Founders Teaser Section -->
  <section class="section" aria-labelledby="founders-teaser-heading">
    <div class="container">
      <div class="founders-teaser-box">
        <div>
          <span class="eyebrow">Creative Direction &amp; Leadership</span>
          <h2 id="founders-teaser-heading" style="font-size: var(--text-3xl); margin-bottom: var(--space-4);">
            Meet the Visionaries Behind Every Masterpiece
          </h2>
          <p style="font-size: var(--text-md); color: var(--color-text-secondary); line-height: var(--leading-relaxed); margin-bottom: var(--space-4);">
            From architectural scenography to multi-city hospitality logistics, our founding directors personally oversee each commission, ensuring that your celebration receives our undivided focus, artistry, and discretion.
          </p>
          <a href="/founders" class="btn btn-primary">
            <span>Read Founders' Profiles</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div style="background-color: var(--color-cream-50); border: 1px solid var(--color-cream-200); border-radius: var(--radius-xl); padding: var(--space-6);">
          <div class="founders-teaser-avatars">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&q=80&auto=format&fit=crop"
              alt="Arjun Mehta, Co-Founder and Creative Director"
              class="teaser-avatar-img"
              width="64"
              height="64"
              loading="lazy"
            />
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=300&q=80&auto=format&fit=crop"
              alt="Ananya Rao, Co-Founder and Managing Director"
              class="teaser-avatar-img"
              width="64"
              height="64"
              loading="lazy"
            />
            <div>
              <strong style="display: block; font-size: var(--text-sm); color: var(--color-navy-950);">Arjun Mehta &amp; Ananya Rao</strong>
              <span style="font-size: var(--text-xs); color: var(--color-text-muted);">Founding Directors</span>
            </div>
          </div>
          <p style="font-family: var(--font-display); font-style: italic; font-size: var(--text-md); color: var(--color-navy-900); line-height: var(--leading-normal); margin-bottom: 0;">
            &ldquo;We don&rsquo;t simply organize an event; we sculpt a memory that echoes for generations.&rdquo;
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Global CTA Band -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading">Envisioning an Extraordinary Occasion?</h2>
      <p>
        Let our creative team craft a bespoke production tailored to your location, guest count, and aesthetic vision.
      </p>
      <div class="cta-actions">
        <a href="/enquiry" class="btn btn-primary btn-lg">
          <span>Schedule a Consultation</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="https://wa.me/919876543210?text=Hi%20Eventina%2C%20I%20would%20like%20to%20learn%20more%20about%20your%20event%20services"
          class="btn btn-secondary btn-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
