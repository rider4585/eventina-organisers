      { text: 'Set Duration: 3 – 5 Hours | Immersive Sound Architecture', icon: 'clock' },
    ],
    enquiryParam: 'DJ-Nyx',
  },
  {
    name: 'Kunal Vardhan',
    category: 'anchors',
    badge: 'Arena Emcee',
    genreSubtitle: 'Corporate Summit & High-Impact Gala Host',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&q=80&auto=format&fit=crop',
    alt: 'Kunal Vardhan, dynamic corporate and sports event anchor',
    desc: 'Commanding, sharp, and impeccably articulate. Kunal brings gravitas and quick spontaneity to leadership galas, automotive reveals, and dynamic baraat grand entries.',
