    ],
    enquiryParam: 'Agni-Kathak',
  },
  {
    name: 'The Velvet Jazz Quintet',
    category: 'instrumental',
    badge: 'Acoustic Jazz',
    genreSubtitle: 'Vintage Swing, Bossa Nova & Gatsby Melodies',
    image: 'https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=800&q=80&auto=format&fit=crop',
