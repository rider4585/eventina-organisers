    alt: 'Ruhani Qawwali Brothers performing ecstatic Sufi music',
    desc: 'A 7-member troupe delivering spellbinding verses of divine romance, syncopated clapping, and powerful vocal harmonies that lift the entire audience into shared euphoria.',
    highlights: [
      { text: 'Performed across royal forts in Rajasthan & heritage estates', icon: 'star' },
      { text: 'Set Duration: 120 Mins | Authentic Acoustic Stage Setup', icon: 'clock' },
    ],
    enquiryParam: 'Ruhani-Qawwali',
  },
  {
    name: 'Mayuri Theatrical Folk Ensemble',
    category: 'dancers',
    badge: 'Folk & Cultural',
    genreSubtitle: 'Ghoomar, Chari Fire Dance & Royal Dhol Acts',
    image: 'https://images.unsplash.com/photo-1547153760-18fc86324498?w=800&q=80&auto=format&fit=crop',
    alt: 'Mayuri Theatrical Folk Dance Ensemble in vibrant traditional costumes',
    desc: 'Splendid cultural pageantry featuring swirling Ghoomar skirts, balancing brass fire urns, and thunderous Nagada drums that provide unmatched ceremonial grandeur for baraats and welcomes.',
    highlights: [
      { text: 'Authentic Rajasthani and Gujarati heritage performers', icon: 'star' },
      { text: '12 Performer Troupe | Grand Entrance & Interactive Dance', icon: 'clock' },
    ],
    enquiryParam: 'Mayuri-Folk',
