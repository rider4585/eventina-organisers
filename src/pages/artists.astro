    desc: 'Pioneering high-energy afterparty sets that blend festival-grade electronic beats with live trumpet and saxophone riffs, keeping guests captivated till sunrise.',
    highlights: [
      { text: 'Headline DJ for destination weddings in Goa & Dubai', icon: 'star' },
      { text: 'Set Duration: 3 – 4 Hours | Live Sax & Percussion Add-on', icon: 'clock' },
    ],
    enquiryParam: 'DJ-Kabir',
  },
  {
    name: 'The Royale Symphony Strings',
    category: 'instrumental',
    badge: 'Symphony Chamber',
    genreSubtitle: 'Cinematic Film Scores & Pop Reinterpretations',
    image: 'https://images.unsplash.com/photo-1465847899084-d164df4dedc6?w=800&q=80&auto=format&fit=crop',
    alt: 'The Royale Symphony String Quartet performing at a champagne gala',
    desc: 'An 8-piece classical chamber ensemble rendering Bollywood classics, Bridgerton-style pop covers, and Western symphonies for grand walk-ins and cocktail receptions.',
    highlights: [
      { text: 'Resident ensemble at Taj West End & Bengaluru Glasshouse', icon: 'star' },
      { text: 'Set Duration: 2 Hours | Acoustic or Amplified Audio', icon: 'clock' },
    ],
    enquiryParam: 'Royale-Strings',
  },
  {
    name: 'Rhea Sen Sharma',
    category: 'anchors',
    badge: 'Celebrity Emcee',
    genreSubtitle: 'Bilingual Luxury Host & Protocol Master',
    image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&q=80&auto=format&fit=crop',
    alt: 'Rhea Sen Sharma, luxury celebrity emcee and host',
    desc: 'Poised, witty, and effortlessly engaging across English, Hindi, and Bengali. Expert in guiding high-stakes corporate award galas and multi-generational sangeets with warmth and elegance.',
    highlights: [
      { text: 'Host for 200+ luxury destination sangeets & CXO summits', icon: 'star' },
      { text: 'Full Evening Curation | Custom Scripting & Family Liaison', icon: 'clock' },
    ],
    enquiryParam: 'Rhea-Sen',
  },
  {
    name: 'Agni Kathak Collective',
    category: 'dancers',
    badge: 'Dance Ensemble',
    genreSubtitle: 'Classical Kathak & Kinetic Light Choreography',
    image: 'https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=800&q=80&auto=format&fit=crop',
    alt: 'Agni Contemporary Kathak Troupe performing with dramatic lighting',
    desc: 'A 10-dancer fusion ensemble combining classical ghungroo rhythmics with cinematic stage lighting, theatrical props, and soaring musical compositions for high-impact opening acts.',
    highlights: [
      { text: 'Specialists in bespoke couple reveal & sangeet openers', icon: 'star' },
