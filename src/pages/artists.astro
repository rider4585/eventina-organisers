---

<BaseLayout
  title="Artists & Curated Talent Roster | Eventina Organisers"
  description="Explore Eventina's curated directory of master musicians, Sufi ensembles, symphony quartets, celebrity DJs, emcees, and dance troupes for luxury events across India."
  ogImage="https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=1200&q=80&auto=format&fit=crop"
>
  <!-- Interior Hero Banner -->
  <section class="page-hero" aria-labelledby="artists-hero-title">
    <div class="container page-hero-inner">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li aria-current="page">Artists</li>
        </ol>
      </nav>

      <span class="eyebrow">Entertainment &amp; Live Performances</span>
      <h1 id="artists-hero-title" class="page-hero-title">
        Curated Talent &amp; Master Ensembles
      </h1>
      <p class="page-hero-lead">
        Electrify your celebrations with India’s most distinguished classical maestros, Sufi ensembles, symphony quartets, celebrity DJs, and charismatic emcees.
      </p>
    </div>
  </section>

  <!-- Artists Showcase Section -->
  <section class="section" aria-labelledby="showcase-heading">
    <div class="container">
      
      <!-- Filter Controls -->
      <div class="artists-filter-wrapper">
        <h2 id="showcase-heading" class="sr-only">Filter Artists by Genre</h2>
        <div class="artist-filter-container" role="toolbar" aria-label="Filter artists by discipline">
          <button type="button" class="artist-filter-btn is-active" data-artist-filter="all" aria-pressed="true">
            <span>All Talents</span>
            <span class="artist-filter-count">12</span>
          </button>
          <button type="button" class="artist-filter-btn" data-artist-filter="vocalists" aria-pressed="false">
            <span>Vocalists &amp; Bands</span>
            <span class="artist-filter-count">3</span>
          </button>
          <button type="button" class="artist-filter-btn" data-artist-filter="djs" aria-pressed="false">
            <span>DJs &amp; Electronic</span>
            <span class="artist-filter-count">2</span>
          </button>
          <button type="button" class="artist-filter-btn" data-artist-filter="instrumental" aria-pressed="false">
            <span>Classical &amp; Instrumental</span>
            <span class="artist-filter-count">3</span>
          </button>
          <button type="button" class="artist-filter-btn" data-artist-filter="anchors" aria-pressed="false">
            <span>Anchors &amp; Emcees</span>
            <span class="artist-filter-count">2</span>
          </button>
          <button type="button" class="artist-filter-btn" data-artist-filter="dancers" aria-pressed="false">
            <span>Dancers &amp; Troupes</span>
            <span class="artist-filter-count">2</span>
          </button>
        </div>

        <!-- Live Status Indicator -->
        <div class="artists-live-status" id="artist-count-display" aria-live="polite">
          Showing all 12 master talents &amp; performance ensembles
        </div>
      </div>

      <!-- Empty State Container -->
      <div id="artist-empty-state" class="artist-empty-state" hidden>
        <h3 style="font-size: var(--text-xl); color: var(--color-navy-950); margin-bottom: var(--space-2);">No Artists Found</h3>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">We frequently commission custom acts and international guest performers not listed here.</p>
        <a href="/enquiry?service=entertainment" class="btn btn-primary">
          <span>Enquire with Talent Concierge</span>
        </a>
      </div>

      <!-- Artists Grid -->
      <div class="artists-grid" id="artists-grid-container">
        {artists.map((artist) => (
          <article class="artist-card" data-artist-category={artist.category}>
            <div class="artist-media-box">
              <img
                src={artist.image}
                alt={artist.alt}
                width="800"
                height="550"
                loading="lazy"
              />
              <span class="artist-badge-pill">{artist.badge}</span>
            </div>
            <div class="artist-body">
              <h3 class="artist-name">{artist.name}</h3>
              <div class="artist-genre-subtitle">{artist.genreSubtitle}</div>
              <p class="artist-desc">{artist.desc}</p>
              <ul class="artist-highlights">
                {artist.highlights.map((hl) => (
                  <li class="artist-highlight-item">
                    {hl.icon === 'star' ? (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                    <span>{hl.text}</span>
                  </li>
                ))}
              </ul>
              <div class="artist-actions">
                <a href={`/enquiry?service=entertainment&artist=${artist.enquiryParam}`} class="btn btn-primary btn-sm" style="width: 100%;">
                  <span>Book for Event</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Talent Concierge Box -->
      <div class="artist-talent-concierge">
        <div>
          <span class="eyebrow" style="color: var(--color-gold-400);">Turnkey Talent Management</span>
          <h2>Why Commission Talent Through Eventina?</h2>
          <p>
            Securing high-profile performers requires far more than just a phone call. We manage every technical acoustic rider, soundcheck timeline, PPL/IPRS copyright license, VIP backstage suite, and travel manifest — ensuring seamless, stress-free performances.
          </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-3); justify-content: center;">
          <div style="display: flex; align-items: center; gap: var(--space-3); color: var(--color-gold-300); font-size: var(--text-sm);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>100% Contract &amp; Date Guarantees</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3); color: var(--color-gold-300); font-size: var(--text-sm);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Custom Musical Mashups &amp; Rehearsals</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3); color: var(--color-gold-300); font-size: var(--text-sm);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Full Audio-Visual &amp; Monitor Redundancy</span>
          </div>
          <a href="/enquiry?service=entertainment" class="btn btn-primary" style="margin-top: var(--space-2);">
            <span>Consult Our Talent Desk</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Global CTA Band -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading">Seeking a Specific Headline Celebrity or Performer?</h2>
      <p>
        Through our proprietary booking network, we coordinate directly with India's leading playback singers, stand-up comedians, and international acts.
      </p>
      <div class="cta-actions">
        <a href="/enquiry?service=entertainment" class="btn btn-primary btn-lg">
          <span>Request Talent Availability</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/portfolio" class="btn btn-secondary btn-lg">
          <span>Explore Past Stages</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Artist filter & URL query handling
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-artist-filter]');
  const artistCards = document.querySelectorAll<HTMLElement>('[data-artist-category]');
  const countDisplay = document.getElementById('artist-count-display');
  const emptyState = document.getElementById('artist-empty-state');
  const totalCount = artistCards.length;

  if (filterButtons.length && artistCards.length) {
    function applyFilter(category: string) {
      let visibleCount = 0;

      artistCards.forEach((card) => {
        const itemCategory = card.getAttribute('data-artist-category');
        const matches = (category === 'all' || itemCategory === category);

        if (matches) {
          card.classList.remove('is-hidden');
          card.removeAttribute('hidden');
          visibleCount++;
        } else {
          card.classList.add('is-hidden');
          card.setAttribute('hidden', '');
        }
      });

      filterButtons.forEach((btn) => {
        const isCurrent = btn.getAttribute('data-artist-filter') === category;
        btn.classList.toggle('is-active', isCurrent);
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });

      if (countDisplay) {
        if (category === 'all') {
          countDisplay.textContent = `Showing all ${totalCount} master talents & performance ensembles`;
        } else {
          countDisplay.textContent = `Showing ${visibleCount} of ${totalCount} talents in this genre`;
        }
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.add('is-visible');
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.classList.remove('is-visible');
          emptyState.setAttribute('hidden', '');
        }
      }
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const category = button.getAttribute('data-artist-filter') || 'all';
        applyFilter(category);
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const genreParam = urlParams.get('genre');
    if (genreParam) {
      const targetBtn = document.querySelector<HTMLButtonElement>(`[data-artist-filter="${genreParam}"]`);
      if (targetBtn) {
        applyFilter(genreParam);
      }
    }
  }
</script>
