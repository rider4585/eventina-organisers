---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Founders & Leadership | Eventina Organisers"
  description="Meet the visionary founders of Eventina Organisers: Arjun Mehta, Ananya Rao, and Vikramaditya Sengupta. Bringing architectural elegance, hospitality mastery, and technical precision to celebrations across India."
  ogImage="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&q=80&auto=format&fit=crop"
>
  <!-- Interior Hero Banner -->
  <section class="page-hero" aria-labelledby="founders-hero-title">
    <div class="container page-hero-inner">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li><a href="/about">About Us</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li aria-current="page">Founders</li>
        </ol>
      </nav>

      <span class="eyebrow">Leadership &amp; Creative Direction</span>
      <h1 id="founders-hero-title" class="page-hero-title">
        The Visionaries Behind Eventina
      </h1>
      <p class="page-hero-lead">
        Meet the minds uniting architectural spatial design, five-star luxury hospitality, and arena-grade technical production into every celebration.
      </p>
    </div>
  </section>

  <!-- Founders Intro Narrative -->
  <section class="section" aria-labelledby="founders-ethos-heading">
    <div class="container">
      <div class="founders-lead-banner">
        <span class="eyebrow">The Leadership Philosophy</span>
        <h2 id="founders-ethos-heading" style="font-size: var(--text-3xl); margin-bottom: var(--space-4);">
          Where Artistic Audacity Meets Flawless Execution
        </h2>
        <p>
          At Eventina, our founding partners don’t delegate creative vision to distant subcontractors. Each commission is directly stewarded by our directors, ensuring that every nuance of aesthetic curation, acoustic staging, and guest hospitality reflects your distinct standards.
        </p>
      </div>

      <!-- Founders Cards Grid -->
      <div class="founders-grid founders-grid-3">
        <!-- Founder 1: Arjun Mehta -->
        <article class="founder-card">
          <div class="founder-photo-box">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80&auto=format&fit=crop"
              alt="Arjun Mehta, Co-Founder and Creative Director of Eventina Organisers"
              width="800"
              height="1000"
              loading="lazy"
            />
            <div class="founder-photo-overlay">
              <span class="founder-role-badge">Co-Founder &amp; Creative Director</span>
            </div>
          </div>

          <div class="founder-details">
            <h3 class="founder-name">Arjun Mehta</h3>
            <p class="founder-bio">
              Trained as an architectural designer, Arjun spent over a decade reimagining historic palace grounds, private islands, and luxury hotel ballrooms into breathtaking narrative landscapes. He leads spatial planning, custom floral architecture, and mood curation for Eventina’s signature events.
            </p>
            <blockquote class="founder-quote">
              &ldquo;Every venue holds an innate character. Our duty is to elevate it with sculptural florals, light, and timeless proportions.&rdquo;
            </blockquote>

            <div class="founder-expertise" aria-label="Key areas of expertise for Arjun Mehta">
              <span class="expertise-chip">Spatial Scenography</span>
              <span class="expertise-chip">Floral Architecture</span>
              <span class="expertise-chip">Palace Venues</span>
            </div>

            <div class="founder-social-links" aria-label="Social profiles for Arjun Mehta">
              <a href="https://linkedin.com" class="founder-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Arjun Mehta on LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
              <a href="https://instagram.com" class="founder-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Arjun Mehta on Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Founder 2: Ananya Rao -->
        <article class="founder-card">
          <div class="founder-photo-box">
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=800&q=80&auto=format&fit=crop"
              alt="Ananya Rao, Co-Founder and Managing Director of Eventina Organisers"
              width="800"
              height="1000"
              loading="lazy"
            />
            <div class="founder-photo-overlay">
              <span class="founder-role-badge">Co-Founder &amp; Managing Director</span>
            </div>
          </div>

          <div class="founder-details">
            <h3 class="founder-name">Ananya Rao</h3>
            <p class="founder-bio">
              With a background in luxury hotel management and VIP diplomatic protocol, Ananya orchestrates multi-city travel logistics, luxury charter fleets, and bespoke guest concierges with calm mastery. She ensures that hosts and guests experience complete tranquility.
            </p>
            <blockquote class="founder-quote">
              &ldquo;True luxury is effortless on the surface because hundreds of moving parts have been harmonized beforehand with clockwork care.&rdquo;
            </blockquote>

            <div class="founder-expertise" aria-label="Key areas of expertise for Ananya Rao">
              <span class="expertise-chip">Turnkey Hospitality</span>
              <span class="expertise-chip">Destination Logistics</span>
              <span class="expertise-chip">VIP Concierge</span>
            </div>

            <div class="founder-social-links" aria-label="Social profiles for Ananya Rao">
              <a href="https://linkedin.com" class="founder-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Ananya Rao on LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
              <a href="https://instagram.com" class="founder-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Ananya Rao on Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Founder 3: Vikramaditya Sengupta -->
        <article class="founder-card">
          <div class="founder-photo-box">
            <img
              src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&q=80&auto=format&fit=crop"
              alt="Vikramaditya Sengupta, Partner and Head of Technical Production"
              width="800"
              height="1000"
              loading="lazy"
            />
            <div class="founder-photo-overlay">
              <span class="founder-role-badge">Partner &amp; Head of Production</span>
            </div>
          </div>

          <div class="founder-details">
            <h3 class="founder-name">Vikramaditya Sengupta</h3>
            <p class="founder-bio">
              A veteran of high-voltage concert production, international film festivals, and broadcast galas, Vikramaditya commands the technical spine of Eventina. He oversees acoustic engineering, motorized kinetic staging, and celebrity artist hospitality riders.
            </p>
            <blockquote class="founder-quote">
              &ldquo;Magic in live production is born from precision. When acoustic clarity and lighting synchrony hit in unison, the energy in the room is electrifying.&rdquo;
            </blockquote>

            <div class="founder-expertise" aria-label="Key areas of expertise for Vikramaditya Sengupta">
              <span class="expertise-chip">Concert AV Systems</span>
              <span class="expertise-chip">Kinetic Stagecraft</span>
              <span class="expertise-chip">Artist Liaison</span>
            </div>

            <div class="founder-social-links" aria-label="Social profiles for Vikramaditya Sengupta">
              <a href="https://linkedin.com" class="founder-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Vikramaditya Sengupta on LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
              <a href="https://instagram.com" class="founder-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Vikramaditya Sengupta on Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Leadership Commitments Section -->
  <section class="section founder-ethos-section" aria-labelledby="ethos-heading">
    <div class="container">
      <div class="section-header text-center">
        <span class="eyebrow">Our Guiding Creed</span>
        <h2 id="ethos-heading">The Eventina Leadership Commitments</h2>
        <p>Principles that govern every relationship, production decision, and celebration we direct.</p>
      </div>

      <div class="ethos-grid">
        <div class="ethos-card">
          <h3>Direct Partner Stewardship</h3>
          <p>We take on a strictly limited number of commissions per calendar season. Arjun, Ananya, or Vikramaditya is physically present at every major walkthrough, rehearsal, and live production.</p>
        </div>

        <div class="ethos-card">
          <h3>Discreet VIP Protection</h3>
          <p>From prominent business families to celebrity icons, privacy is sacrosanct. We maintain strict non-disclosure agreements, encrypted guest manifests, and perimeter access controls.</p>
        </div>

        <div class="ethos-card">
          <h3>Zero Commission Bias</h3>
          <p>We recommend venues, florists, and artists based solely on aesthetic and operational excellence. Our vendor curation is transparent, unbiased, and aligned completely with your interests.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Global CTA Band -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading">Collaborate Directly with Our Founding Team</h2>
      <p>
        Schedule a private creative consultation to explore concepts, feasibility, and custom scenography for your upcoming celebration.
      </p>
      <div class="cta-actions">
        <a href="/enquiry" class="btn btn-primary btn-lg">
          <span>Schedule Creative Consultation</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/about" class="btn btn-secondary btn-lg">
          <span>Explore Company Story</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
