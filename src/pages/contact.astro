---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Eventina Organisers — Event Directors Desk"
  description="Get in touch with Eventina Organisers in Pune. Direct phone desk, executive email, and consultation request form for luxury event planning across India."
  ogImage="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1200&q=80&auto=format&fit=crop"
>
  <!-- Interior Hero Banner -->
  <section class="page-hero" aria-labelledby="contact-page-title">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1600&q=80&auto=format&fit=crop"
        alt="Warmly lit event banquet setup"
        width="1600"
        height="700"
      />
    </div>
    <div class="page-hero-scrim" aria-hidden="true"></div>

    <div class="container page-hero-content">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="breadcrumbs-separator" aria-hidden="true">/</span>
        <span class="breadcrumbs-current" aria-current="page">Contact Us</span>
      </nav>

      <h1 id="contact-page-title" class="page-hero-title">
        Connect With Our Event Directors
      </h1>
      <p class="page-hero-lead">
        We invite you to discuss your upcoming celebration. Speak directly with our executive planning team in Pune or connect with our directors across India.
      </p>
    </div>
  </section>

  <!-- Contact Channels & Consultation Form -->
  <section class="section" aria-labelledby="connect-heading">
    <div class="container">
      <div class="grid-2" style="align-items: start; gap: var(--space-8);">
        <!-- Left Column: Contact Intelligence & Details -->
        <div>
          <h2 id="connect-heading" style="font-size: var(--text-3xl); margin-bottom: var(--space-4);">
            Direct Desk &amp; Consultation Details
          </h2>
          <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6); line-height: var(--leading-relaxed);">
            Our planning team is at your service for confidential consultations, venue assessments, and production briefings. Reach us by phone, email, or WhatsApp.
          </p>

          <div class="contact-info-list" role="list">
            <!-- Phone Desk -->
            <div class="contact-item-card" role="listitem">
              <div class="contact-icon-wrapper" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div>
                <div class="contact-item-label">Telephone Direct Desk</div>
                <div class="contact-item-value">
                  <a href="tel:+919767177776">+91 97671 77776</a><br />
                  <a href="tel:+919767277776">+91 97672 77776</a>
                </div>
                <div style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.25rem;">
                  Available Mon – Sat, 10:00 AM – 7:30 PM IST
                </div>
              </div>
            </div>

            <!-- Executive Email -->
            <div class="contact-item-card" role="listitem">
              <div class="contact-icon-wrapper" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div>
                <div class="contact-item-label">Executive Inquiries</div>
                <div class="contact-item-value">
                  <a href="mailto:Eventinapvtltd@gmail.com">Eventinapvtltd@gmail.com</a>
                </div>
                <div style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.25rem;">
                  Direct inbox of our leadership team
                </div>
              </div>
            </div>

            <!-- Main Location (Pune) -->
            <div class="contact-item-card" role="listitem">
              <div class="contact-icon-wrapper" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <div class="contact-item-label">Headquarters Location</div>
                <div class="contact-item-value">
                  Pune, Maharashtra, India
                </div>
                <div style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.25rem;">
                  Bespoke mobile consultancy · Available nationwide across India
                </div>
              </div>
            </div>

            <!-- WhatsApp Quick Connect -->
            <div class="contact-item-card" style="background-color: var(--color-cream-100); border-color: var(--color-gold-300);" role="listitem">
              <div class="contact-icon-wrapper" style="background-color: var(--color-gold-500); color: #0D1627;" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </div>
              <div>
                <div class="contact-item-label">Instant Messaging</div>
                <div class="contact-item-value">
                  <a href="https://wa.me/919767177776?text=Hi%20Eventina%20Organisers%2C%20I%20would%20like%20to%20enquire%20about%20event%20planning%20services" target="_blank" rel="noopener noreferrer">
                    Direct WhatsApp Chat &rarr;
                  </a>
                </div>
                <div style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: 0.25rem;">
                  Immediate response from our leadership team
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Quick Message Form -->
        <div>
          <div class="form-card">
            <h3 style="font-size: var(--text-2xl); margin-bottom: var(--space-2); color: var(--color-navy-950);">
              Send a Message
            </h3>
            <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-6);">
              Have a quick question or prefer written consultation? Drop us a note below. For detailed quotations with date and budget options, use our <a href="/enquiry" style="color: var(--color-gold-600); font-weight: var(--weight-semibold);">Enquiry Form</a>.
            </p>

            <!-- Success Alert -->
            <div id="contact-success-alert" style="display: none; background-color: var(--color-success-bg); border: 1px solid var(--color-success); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-4); color: var(--color-success);" role="alert">
              <strong style="display: block; font-size: var(--text-md); margin-bottom: 0.25rem;">Message Received!</strong>
              <p style="font-size: var(--text-sm); color: #155724; margin: 0;">
                Thank you for reaching out. One of our Senior Event Directors will call or email you shortly.
              </p>
            </div>

            <form id="contact-form" novalidate>
              <!-- Full Name -->
              <div class="form-group">
                <label for="contact-name" class="form-label">
                  <span>Your Full Name</span>
                  <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <input type="text" id="contact-name" name="name" class="form-control" placeholder="e.g. Meera Kapoor" required autocomplete="name" />
                <div class="form-error" id="contact-name-error" role="alert"></div>
              </div>

              <!-- Phone & Email Grid -->
              <div class="grid-2" style="gap: var(--space-4);">
                <div class="form-group">
                  <label for="contact-phone" class="form-label">
                    <span>Phone Number</span>
                    <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <input type="tel" id="contact-phone" name="phone" class="form-control" placeholder="+91 98765 43210" required autocomplete="tel" />
                  <div class="form-error" id="contact-phone-error" role="alert"></div>
                </div>

                <div class="form-group">
                  <label for="contact-email" class="form-label">
                    <span>Email Address</span>
                    <span class="required-indicator" aria-hidden="true">*</span>
                  </label>
                  <input type="email" id="contact-email" name="email" class="form-control" placeholder="meera@example.com" required autocomplete="email" />
                  <div class="form-error" id="contact-email-error" role="alert"></div>
                </div>
              </div>

              <!-- Subject -->
              <div class="form-group">
                <label for="contact-subject" class="form-label">
                  <span>Subject / Celebration Interest</span>
                </label>
                <select id="contact-subject" name="subject" class="form-select">
                  <option value="Destination Wedding">Destination Wedding Consultation</option>
                  <option value="Corporate Summit">Corporate Convention / Gala</option>
                  <option value="Live Artist">Artist Booking &amp; Entertainment</option>
                  <option value="Private Soiree">Private Milestone Soirée</option>
                  <option value="General Query">General Press / Vendor Collaboration</option>
                </select>
              </div>

              <!-- Message -->
              <div class="form-group">
                <label for="contact-message" class="form-label">
                  <span>Your Message / Event Summary</span>
                  <span class="required-indicator" aria-hidden="true">*</span>
                </label>
                <textarea id="contact-message" name="message" class="form-textarea" placeholder="Please share details such as anticipated city, approximate guest count, or any specific artist or decor requirements..." required></textarea>
                <div class="form-error" id="contact-message-error" role="alert"></div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg" id="contact-submit-btn" style="width: 100%; margin-top: var(--space-2);">
                <span>Send Message</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Head Office & Map Preview Section -->
  <section class="section section-cream" aria-labelledby="map-section-heading">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="map-section-heading">Headquartered in Pune · Directing Celebrations Across India</h2>
        <p>
          We operate as a bespoke mobile consultancy without a physical storefront, meeting our clients on-site at chosen venues, private estates, or via scheduled virtual consultations.
        </p>
      </div>

      <div class="map-preview-card">
        <!-- Accessible Map Embed Preview Frame using OpenStreetMap -->
        <iframe
          class="map-embed-frame"
          title="Eventina Organisers Pune location map"
          src="https://www.openstreetmap.org/export/embed.html?bbox=73.75%2C18.45%2C73.95%2C18.60&amp;layer=mapnik&amp;marker=18.5204%2C73.8567"
          loading="lazy"
        ></iframe>

        <div class="map-card-footer">
          <div>
            <strong style="color: var(--color-navy-950); display: block;">Eventina Organisers</strong>
            <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">Pune, Maharashtra, India</span>
          </div>
          <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
            <a href="https://maps.google.com/?q=Pune+Maharashtra+India" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              <span>Open in Google Maps &rarr;</span>
            </a>
            <a href="/locations" class="btn btn-dark btn-sm">
              <span>View Event Destinations &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Global CTA Band -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading">Ready to Discuss Your Date?</h2>
      <p>
        Consult directly with our event directors to design a tailor-made celebration that will be remembered for years to come.
      </p>
      <div class="cta-actions">
        <a href="/enquiry" class="btn btn-primary btn-lg">
          <span>Detailed Enquiry Form</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="https://wa.me/919767177776?text=Hi%20Eventina%20Organisers%2C%20I%20would%20like%20to%20enquire%20about%20event%20planning%20services"
          class="btn btn-secondary btn-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Instant WhatsApp Chat</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Form handling & validation script for contact form
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactSuccessAlert = document.getElementById('contact-success-alert') as HTMLElement | null;
  const contactSubmitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

  function validateEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePhone(phone: string): boolean {
    const cleaned = phone.replace(/[\s\-\(\)]/g, '');
    return /^\+?[0-9]{10,14}$/.test(cleaned);
  }

  function showError(fieldId: string, errorMsg: string) {
    const field = document.getElementById(fieldId);
    const errorEl = document.getElementById(`${fieldId}-error`);
    if (field) {
      field.classList.add('is-invalid');
      field.setAttribute('aria-invalid', 'true');
    }
    if (errorEl) {
      errorEl.textContent = errorMsg;
      errorEl.classList.add('is-visible');
    }
  }

  function clearError(fieldId: string) {
    const field = document.getElementById(fieldId);
    const errorEl = document.getElementById(`${fieldId}-error`);
    if (field) {
      field.classList.remove('is-invalid');
      field.removeAttribute('aria-invalid');
    }
    if (errorEl) {
      errorEl.classList.remove('is-visible');
      errorEl.textContent = '';
    }
  }

  ['contact-name', 'contact-phone', 'contact-email', 'contact-message'].forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', () => clearError(id));
      el.addEventListener('change', () => clearError(id));
    }
  });

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      let isValid = true;

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

      const name = nameInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      const phone = phoneInput?.value.trim() || '';
      const message = messageInput?.value.trim() || '';

      if (!name || name.length < 2) {
        showError('contact-name', 'Please provide your name.');
        isValid = false;
      } else {
        clearError('contact-name');
      }

      if (!email || !validateEmail(email)) {
        showError('contact-email', 'Please provide a valid email address.');
        isValid = false;
      } else {
        clearError('contact-email');
      }

      if (!phone || !validatePhone(phone)) {
        showError('contact-phone', 'Please enter a valid phone number.');
        isValid = false;
      } else {
        clearError('contact-phone');
      }

      if (!message || message.length < 10) {
        showError('contact-message', 'Please write a brief message of at least 10 characters.');
        isValid = false;
      } else {
        clearError('contact-message');
      }

      if (!isValid) return;

      if (contactSubmitBtn) {
        contactSubmitBtn.disabled = true;
        contactSubmitBtn.innerHTML = `<span>Sending Message...</span>`;
      }

      setTimeout(() => {
        contactForm.reset();
        if (contactSuccessAlert) {
          contactSuccessAlert.style.display = 'block';
          contactSuccessAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (contactSubmitBtn) {
          contactSubmitBtn.disabled = false;
          contactSubmitBtn.innerHTML = `
            <span>Send Message</span>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          `;
        }
      }, 600);
    });
  }
</script>
