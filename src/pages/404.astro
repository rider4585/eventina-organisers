---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Eventina Organisers"
  description="The celebration or page you are seeking could not be located. Discover our bespoke wedding planning and corporate event services."
  canonicalURL="https://eventina.in/404"
>
  <section class="section text-center" style="padding: clamp(5rem, 10vw, 8rem) var(--space-4); min-height: 65vh; display: flex; align-items: center;">
    <div class="container container-sm" style="max-width: 680px; margin-inline: auto;">
      <span class="eyebrow" style="color: var(--color-gold-600); letter-spacing: 0.25em; display: block; margin-bottom: var(--space-2);">
        Error 404
      </span>
      <h1 class="display-title" style="font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5.5rem); margin: var(--space-2) 0 var(--space-4); color: var(--color-navy-950); line-height: 1.05;">
        A Moment Paused
      </h1>
      <p class="hero-lead" style="margin-bottom: var(--space-8); color: var(--color-text-muted); font-size: var(--text-lg); line-height: var(--leading-relaxed);">
        The page or event chronicle you requested has transitioned into memory or moved to another venue. Allow us to guide you back to our featured celebrations.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">
          <span>Return to Homepage</span>
        </a>
        <a href="/services" class="btn btn-secondary">
          <span>Explore Services</span>
        </a>
        <a href="/enquiry" class="btn btn-primary">
          <span>Plan an Event</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
