---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cookie Policy | Eventina Organisers"
  description="Official Cookie Policy of Eventina Organisers — How we utilize essential and analytical tokens to enhance your celebration planning experience."
  canonicalURL="https://eventina.in/cookies"
>
  <!-- Hero Banner -->
  <section class="page-hero-compact" style="padding-block: clamp(3.5rem, 6vw, 5rem); background: var(--color-navy-950); color: var(--color-text-inverse); text-align: center; border-bottom: 1px solid rgba(184, 146, 66, 0.2);">
    <div class="container text-center">
      <span class="eyebrow" style="color: var(--color-gold-400); display: block; margin-bottom: var(--space-2);">Legal &amp; Compliance</span>
      <h1 class="page-title" style="font-family: var(--font-display); font-size: clamp(2.25rem, 4.5vw, 3.5rem); color: #FFFFFF; margin-bottom: var(--space-2);">
        Cookie Policy
      </h1>
      <p class="hero-subtitle" style="font-size: var(--text-sm); color: var(--color-text-inverse-muted); font-family: var(--font-eyebrow); letter-spacing: var(--tracking-wide); text-transform: uppercase;">
        Last updated: October 2026 &bull; Compliant with Indian DPDP Act and International Standards
      </p>
    </div>
  </section>

  <!-- Legal Body Content -->
  <section class="section legal-content-section">
    <div class="container container-prose" style="max-width: 820px; margin-inline: auto;">
      <div class="legal-card-body card" style="padding: clamp(1.5rem, 4vw, 3rem); background: #FFFFFF; border: 1px solid var(--color-cream-200); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); line-height: 1.8;">
        
        <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-navy-950); margin-bottom: var(--space-3);">
          1. What Are Cookies?
        </h2>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-6);">
          Cookies are miniature text tokens placed onto your computing device or mobile terminal by web servers when you navigate internet properties. They facilitate smooth site navigation, preserve preferred settings, and generate anonymised performance metrics.
        </p>

        <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-navy-950); margin-bottom: var(--space-3);">
          2. Categories of Cookies We Employ
        </h2>
        <ul style="color: var(--color-text-secondary); padding-left: 1.25rem; margin-bottom: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3);">
          <li>
            <strong>Essential Cookies:</strong> Required to enable core navigation, View Transitions, security protocols, and responsive layout scaling.
          </li>
          <li>
            <strong>Analytical Cookies:</strong> Employed through Google Analytics 4 (GA4) with IP anonymization to evaluate page traffic volumes, popular event categories, and session durations without identifying individuals.
          </li>
          <li>
            <strong>Interactive Cookies:</strong> Utilized by our Leaflet mapping integration and social link components to render venue markers and interactive location panels.
          </li>
        </ul>

        <h2 style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-navy-950); margin-bottom: var(--space-3);">
          3. Managing Cookie Preferences
        </h2>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          You can adjust, restrict, or wipe stored cookie permissions via your browser preferences at any moment. Disabling functional cookies will not prevent core exploration of our service galleries or enquiry pathways.
        </p>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;">
          Questions regarding our tracking framework may be forwarded to <a href="mailto:hello@eventina.in" style="color: var(--color-gold-700); text-decoration: underline;">hello@eventina.in</a>.
        </p>

      </div>
    </div>
  </section>
</BaseLayout>
