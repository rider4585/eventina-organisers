---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Extract h2 headings for Table of Contents
const tocHeadings = headings.filter((h) => h.depth === 2);

// Related posts
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const formatFullDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};

const canonicalUrl = `https://eventina.in/blog/${entry.id}`;

// Structured Data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: entry.data.pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: entry.data.author,
    jobTitle: entry.data.authorRole,
    url: 'https://eventina.in/founders',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Eventina Organisers',
    logo: {
      '@type': 'ImageObject',
      url: 'https://eventina.in/assets/img/icon-crest.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<BaseLayout
  title={`${entry.data.title} | The Eventina Journal`}
  description={entry.data.description}
  ogImage={entry.data.image}
  canonicalURL={canonicalUrl}
  type="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Reading Progress Bar -->
  <div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>

  <!-- Editorial Article Header Banner -->
  <header class="article-header">
    <div class="container text-center">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li><a href="/blog">The Eventina Journal</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li aria-current="page">{entry.data.category}</li>
        </ol>
      </nav>

      <span class="article-category-badge">{entry.data.category}</span>
      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-subtitle">{entry.data.description}</p>

      <div class="article-meta-row article-meta-bar">
        <div style="display: flex; align-items: center; gap: 8px;">
          <img
            src={entry.data.authorImage}
            alt={entry.data.author}
            style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-gold-400);"
          />
          <span style="font-weight: var(--weight-semibold); color: var(--color-navy-950);">By {entry.data.author}</span>
        </div>
        <span>&bull;</span>
        <time datetime={entry.data.pubDate.toISOString().split('T')[0]}>{formatFullDate(entry.data.pubDate)}</time>
        <span>&bull;</span>
        <span>{entry.data.readTime}</span>
        <span>&bull;</span>
        <span>{entry.data.category} Masterclass</span>
      </div>
    </div>
  </header>

  <!-- Hero Editorial Figure -->
  <div class="container">
    <figure class="article-hero-figure article-hero-media">
      <img
        src={entry.data.image}
        alt={entry.data.imageAlt || entry.data.title}
        class="article-hero-img"
        width="1400"
        height="650"
        loading="eager"
      />
      {entry.data.imageCaption && (
        <figcaption class="article-hero-caption article-media-caption">
          {entry.data.imageCaption}
        </figcaption>
      )}
    </figure>
  </div>

  <!-- Article Content Layout with Sticky Table of Contents -->
  <div class="container">
    <div class="article-layout article-reading-layout">
      <!-- Sticky Table of Contents Sidebar -->
      {tocHeadings.length > 0 && (
        <aside class="article-sidebar article-toc-sticky" aria-label="Table of Contents">
          <div class="article-toc-box">
            <h2 class="article-toc-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span>On This Page</span>
            </h2>
            <ul class="article-toc-list">
              {tocHeadings.map((h, idx) => (
                <li>
                  <a href={`#${h.slug}`} class={`article-toc-link ${idx === 0 ? 'is-active' : ''}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}

      <!-- Main Editorial Article Body -->
      <article class="article-body article-content">
        <Content />

        <!-- Footer Box: Author Card & Social Share -->
        <div class="article-footer-box">
          <!-- Social Share Bar -->
          <div class="article-share-strip">
            <span class="article-share-label" style="font-size: var(--text-xs); font-family: var(--font-eyebrow); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--color-navy-900);">
              Share Dispatch:
            </span>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(entry.data.title + ' ' + canonicalUrl)}`}
              class="article-share-btn share-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on WhatsApp"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width: 14px; height: 14px;">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>WhatsApp</span>
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
              class="article-share-btn share-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width: 14px; height: 14px;">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span>LinkedIn</span>
            </a>
            <button type="button" class="article-share-btn share-btn" id="copy-article-link" aria-label="Copy link to clipboard">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width: 14px; height: 14px;">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy Link</span>
            </button>
          </div>

          <!-- Author Profile Card -->
          <div class="article-author-card">
            <img
              src={entry.data.authorImage}
              alt={`${entry.data.author} portrait`}
              class="article-author-avatar article-author-portrait"
              width="80"
              height="80"
            />
            <div class="article-author-details">
              <h3 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-navy-950); margin-bottom: 0.25rem;">
                {entry.data.author}
              </h3>
              <p style="font-family: var(--font-eyebrow); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-gold-600); margin-bottom: 0.35rem;">
                {entry.data.authorRole} &bull; Eventina Organisers
              </p>
              <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: var(--leading-relaxed); margin-bottom: 0.5rem;">
                {entry.data.author === 'Ashwini Digole'
                  ? 'Co-Founder and Creative Director of Eventina Organisers. Ashwini specializes in bespoke scenography, floral architectures, and luxury aesthetics, transforming celebrations across Pune and India\'s finest destinations.'
                  : entry.data.author === 'Aditya Bagade'
                  ? 'Co-Founder and Managing Director of Eventina Organisers. Aditya oversees operations, venue logistics, acoustic engineering, and live entertainment production for landmark celebrations across India.'
                  : 'Founding leader at Eventina Organisers, orchestrating bespoke celebrations, royal weddings, and luxury galas across India.'}
              </p>
              <p style="margin-top: 0.5rem;">
                <a href={entry.data.authorLink || '/founders'} style="font-size: var(--text-xs); color: var(--color-gold-700); font-weight: var(--weight-semibold); text-decoration: underline;">
                  Read {entry.data.author}'s Full Profile &rarr;
                </a>
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <!-- Related Articles Section -->
  {relatedPosts.length > 0 && (
    <section class="section section-alt" aria-labelledby="related-articles-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Continue Reading</span>
          <h2 id="related-articles-heading" class="section-title">
            Related Dispatches from the Journal
          </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-6); max-width: 960px; margin-inline: auto;">
          {relatedPosts.map((related) => (
            <article class="blog-card" data-category={related.data.categorySlug || 'weddings'}>
              <div class="blog-card-media">
                <img
                  src={related.data.image}
                  alt={related.data.imageAlt || related.data.title}
                  class="blog-card-img"
                  width="800"
                  height="500"
                  loading="lazy"
                />
              </div>
              <div class="blog-card-body">
                <div class="blog-card-header">
                  <span class="blog-badge">{related.data.category}</span>
                  <span class="blog-card-date">{related.data.readTime}</span>
                </div>
                <h3 class="blog-card-title">
                  <a href={`/blog/${related.id}`}>
                    {related.data.title}
                  </a>
                </h3>
                <p class="blog-card-excerpt">
                  {related.data.description}
                </p>
                <div class="blog-card-footer">
                  <span class="blog-author-role">By {related.data.author}</span>
                  <a href={`/blog/${related.id}`} class="blog-card-read-link">
                    <span>Read Article</span>
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Client-side Interactive Features Script -->
  <script is:inline src="/assets/js/blog.js"></script>
</BaseLayout>
