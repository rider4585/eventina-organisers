---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Eventina Organisers | Bespoke Celebrations & Luxury Events"
  description="Premier event organisers in India crafting bespoke destination weddings, corporate galas, and milestone celebrations with artistic elegance and meticulous precision."
>
  <!-- Hero Section -->
  <section class="hero-section" style="position: relative; padding: clamp(4rem, 10vw, 8rem) var(--space-4); text-align: center; background: radial-gradient(circle at 50% 20%, rgba(201, 167, 94, 0.12) 0%, transparent 70%), var(--color-cream-50);">
    <div class="container" style="max-width: 840px; margin-inline: auto;">
      <span class="eyebrow" style="display: inline-block; font-family: var(--font-eyebrow); font-size: var(--text-xs); font-weight: var(--weight-semibold); letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-gold-600); margin-bottom: var(--space-3);">
        Haute-Couture Event Planning & Scenography
      </span>
      <h1 style="font-family: var(--font-display); font-size: var(--text-5xl); font-weight: 400; line-height: 1.1; color: var(--color-navy-900); margin-bottom: var(--space-4);">
        Where Artistry Meets <em style="font-style: italic; color: var(--color-gold-500);">Unforgettable</em> Grandeur
      </h1>
      <p style="font-size: var(--text-lg); line-height: 1.6; color: var(--color-text-secondary); margin-bottom: var(--space-6); max-width: 640px; margin-inline: auto;">
        Crafting bespoke destination weddings, royal celebrations, and prestigious corporate galas across Udaipur, Jaipur, Goa, and beyond.
      </p>
      <div style="display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap;">
        <a href="/enquiry" class="btn btn-primary">
          <span>Plan Your Celebration</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width: 1rem; height: 1rem;">
            <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/portfolio" class="btn btn-secondary">
          <span>Explore Portfolio</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Feature Pillars -->
  <section style="padding: clamp(3rem, 6vw, 5rem) var(--space-4); background-color: var(--color-cream-100); border-top: 1px solid var(--color-cream-200); border-bottom: 1px solid var(--color-cream-200);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
        <div class="card" style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid var(--color-cream-200); box-shadow: var(--shadow-sm);">
          <div style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-gold-600); margin-bottom: var(--space-2);">01</div>
          <h2 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-navy-900); margin-bottom: var(--space-2);">Destination Weddings</h2>
          <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6;">
            Palatial heritage venues, private coastal enclaves, and royal hospitality curated to perfection.
          </p>
        </div>
        <div class="card" style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid var(--color-cream-200); box-shadow: var(--shadow-sm);">
          <div style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-gold-600); margin-bottom: var(--space-2);">02</div>
          <h2 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-navy-900); margin-bottom: var(--space-2);">Corporate Galas</h2>
          <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6;">
            Sophisticated corporate summits, award nights, and milestone jubilees delivered with flawless execution.
          </p>
        </div>
        <div class="card" style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-md); border: 1px solid var(--color-cream-200); box-shadow: var(--shadow-sm);">
          <div style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-gold-600); margin-bottom: var(--space-2);">03</div>
          <h2 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-navy-900); margin-bottom: var(--space-2);">Scenography & Décor</h2>
          <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6;">
            Architectural floral installations, bespoke lighting designs, and custom staging crafted by master artisans.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
