---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Event Planning & Production Services | Eventina Organisers"
  description="Explore bespoke event management services by Eventina Organisers: destination weddings, corporate galas, artist curation, floral scenography, and luxury hospitality across India."
  ogImage="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1200&q=80&auto=format&fit=crop"
>
  <!-- Page Hero Banner -->
  <section class="page-hero" aria-labelledby="page-title">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1600&q=80&auto=format&fit=crop"
        alt="Luxury banquet hall adorned with ambient golden chandeliers"
        width="1600"
        height="700"
      />
    </div>
    <div class="page-hero-scrim" aria-hidden="true"></div>

    <div class="container page-hero-content">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="breadcrumbs-separator" aria-hidden="true">/</span>
        <span class="breadcrumbs-current" aria-current="page">Services</span>
      </nav>

      <h1 id="page-title" class="page-hero-title">
        Bespoke Event Planning &amp; Production Services
      </h1>
      <p class="page-hero-lead">
        From royal destination weddings in Rajasthan's majestic palaces to high-impact corporate conventions, we bring unyielding precision, architectural scenography, and effortless hospitality to every milestone.
      </p>
    </div>
  </section>

  <!-- Detailed Services Catalogue -->
  <section class="section" aria-labelledby="services-catalog-heading">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="services-catalog-heading">Comprehensive Event Solutions</h2>
        <p>
          Each service is managed by dedicated discipline specialists, backed by a trusted national vendor network and meticulous run-of-show execution.
        </p>
      </div>

      <div class="grid-3">
        <!-- Service 1: Weddings -->
        <article class="service-card">
          <div class="service-card-media">
            <img
              src="https://images.unsplash.com/photo-1519741497674-611481863552?w=800&q=80&auto=format&fit=crop"
              alt="Opulent destination wedding mandap overlooking lake waters"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <span class="badge badge-gold">Weddings</span>
            <h3 class="service-card-title">Destination &amp; Royal Weddings</h3>
            <p class="service-card-desc">
              Multi-day celebration management across Udaipur, Jaipur, Goa, and Kerala. From royal palace bookings and majestic mandap engineering to thematic Sangeet choreography and custom bridal entries.
            </p>
            <div class="service-pill-list" aria-label="Key wedding inclusions">
              <span class="service-pill">Palace &amp; Resort Venues</span>
              <span class="service-pill">Mandap Architecture</span>
              <span class="service-pill">Thematic Sangeet Sets</span>
              <span class="service-pill">Bridal Concierge</span>
            </div>
            <div class="service-card-footer">
              <a href="/enquiry?service=weddings" class="btn btn-secondary btn-sm" style="width: 100%;">
                <span>Enquire for Weddings</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Service 2: Corporate -->
        <article class="service-card">
          <div class="service-card-media">
            <img
              src="https://images.unsplash.com/photo-1505373877841-8d25f7d46678?w=800&q=80&auto=format&fit=crop"
              alt="Modern conference hall with dynamic lighting and large presentation screens"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <span class="badge badge-gold">Corporate</span>
            <h3 class="service-card-title">Corporate Summits &amp; Galas</h3>
            <p class="service-card-desc">
              High-calibre corporate conferences, annual leadership assemblies, brand unveilings, and award ceremonies. Engineered with broadcast-grade audiovisuals, seamless live stream feeds, and executive protocol.
            </p>
            <div class="service-pill-list" aria-label="Key corporate inclusions">
              <span class="service-pill">Executive Summits</span>
              <span class="service-pill">Annual Awards Nights</span>
              <span class="service-pill">Broadcast Audio-Visual</span>
              <span class="service-pill">Product Launches</span>
            </div>
            <div class="service-card-footer">
              <a href="/enquiry?service=corporate" class="btn btn-secondary btn-sm" style="width: 100%;">
                <span>Plan Corporate Event</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Service 3: Live Entertainment -->
        <article class="service-card">
          <div class="service-card-media">
            <img
              src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=800&q=80&auto=format&fit=crop"
              alt="Live concert performer illuminated under concert spotlights"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <span class="badge badge-gold">Entertainment</span>
            <h3 class="service-card-title">Artist Curation &amp; Booking</h3>
            <p class="service-card-desc">
              Direct booking and stage management of premium talent: celebrated Bollywood playback singers, dynamic indie live bands, international acoustic ensembles, celebrity emcees, and festival DJs.
            </p>
            <div class="service-pill-list" aria-label="Key entertainment inclusions">
              <span class="service-pill">Bollywood Playback Singers</span>
              <span class="service-pill">Live Symphony &amp; Bands</span>
              <span class="service-pill">Celebrity Emcees</span>
              <span class="service-pill">Rider &amp; Stage Tech</span>
            </div>
            <div class="service-card-footer">
              <a href="/enquiry?service=entertainment" class="btn btn-secondary btn-sm" style="width: 100%;">
                <span>Book Artists</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Service 4: Scenography -->
        <article class="service-card">
          <div class="service-card-media">
            <img
              src="https://images.unsplash.com/photo-1527529482837-4698179dc6ce?w=800&q=80&auto=format&fit=crop"
              alt="Lavish floral ceiling canopy with warm candlelit dinner settings"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <span class="badge badge-gold">Production</span>
            <h3 class="service-card-title">Thematic Decor &amp; Scenography</h3>
            <p class="service-card-desc">
              Immersive spatial storytelling that transforms empty grounds and ballrooms into evocative wonderlands. Custom fabrication, kinetic truss lighting, floral installations, and 3D architectural projection.
            </p>
            <div class="service-pill-list" aria-label="Key scenography inclusions">
              <span class="service-pill">Floral Art Installations</span>
              <span class="service-pill">3D Projection Mapping</span>
              <span class="service-pill">Intelligent Ambient Light</span>
              <span class="service-pill">Custom Set Fabrication</span>
            </div>
            <div class="service-card-footer">
              <a href="/enquiry?service=decor" class="btn btn-secondary btn-sm" style="width: 100%;">
                <span>Consult on Decor</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Service 5: Private Soirées -->
        <article class="service-card">
          <div class="service-card-media">
            <img
              src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=800&q=80&auto=format&fit=crop"
              alt="Intimate outdoor milestone banquet under fairy light canopy"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <span class="badge badge-gold">Private Soirées</span>
            <h3 class="service-card-title">Milestones &amp; High-Society Soirées</h3>
            <p class="service-card-desc">
              Exclusive celebrations crafted with intimate sophistication. Milestone anniversaries, silver and golden jubilees, luxury birthday galas, and bespoke estate gatherings with fine dining and curated mixology.
            </p>
            <div class="service-pill-list" aria-label="Key private soiree inclusions">
              <span class="service-pill">Silver &amp; Golden Jubilees</span>
              <span class="service-pill">Milestone Birthdays</span>
              <span class="service-pill">Curated Gastronomy</span>
              <span class="service-pill">Private Bar &amp; Mixology</span>
            </div>
            <div class="service-card-footer">
              <a href="/enquiry?service=private" class="btn btn-secondary btn-sm" style="width: 100%;">
                <span>Plan Private Soirée</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Service 6: Hospitality & Logistics -->
        <article class="service-card">
          <div class="service-card-media">
            <img
              src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=800&q=80&auto=format&fit=crop"
              alt="Luxury hotel lobby concierge desk ready for VIP reception"
              width="800"
              height="500"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <span class="badge badge-gold">Logistics</span>
            <h3 class="service-card-title">Turnkey Hospitality &amp; Logistics</h3>
            <p class="service-card-desc">
              An effortless, white-glove arrival-to-departure guest journey. Dedicated airport concierge teams, chartered coach and luxury vehicle logistics, 24/7 on-site hospitality desks, and bespoke welcome gifting.
            </p>
            <div class="service-pill-list" aria-label="Key logistics inclusions">
              <span class="service-pill">Airport VIP Protocol</span>
              <span class="service-pill">Chauffeur Fleets</span>
              <span class="service-pill">RSVP &amp; Room Allocation</span>
              <span class="service-pill">Bespoke Welcome Hampers</span>
            </div>
            <div class="service-card-footer">
              <a href="/enquiry?service=hospitality" class="btn btn-secondary btn-sm" style="width: 100%;">
                <span>Inquire for Hospitality</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Planning Methodology Section -->
  <section class="section section-cream" aria-labelledby="methodology-heading">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="methodology-heading">Our Curated 4-Step Process</h2>
        <p>
          Disciplined project management paired with boundless artistic imagination. Here is how we take you from concept to a standing ovation.
        </p>
      </div>

      <div class="process-grid">
        <div class="process-step">
          <span class="process-num">01</span>
          <h3 class="process-title">Discovery &amp; Creative Vision</h3>
          <p class="process-desc">
            We explore your expectations, guest demographics, aesthetic desires, and key event milestones to establish a singular creative brief.
          </p>
        </div>

        <div class="process-step">
          <span class="process-num">02</span>
          <h3 class="process-title">Venue Scouting &amp; Blueprints</h3>
          <p class="process-desc">
            We conduct thorough venue feasibility studies, present itemised budget frameworks, and provide 3D spatial renders of decor arrangements.
          </p>
        </div>

        <div class="process-step">
          <span class="process-num">03</span>
          <h3 class="process-title">Curation &amp; Logistics Lock</h3>
          <p class="process-desc">
            Direct contracts with top-tier culinary partners, verified AV technicians, and headline artists with zero ambiguity or unapproved costs.
          </p>
        </div>

        <div class="process-step">
          <span class="process-num">04</span>
          <h3 class="process-title">Flawless On-Site Execution</h3>
          <p class="process-desc">
            Senior event directors oversee minute-by-minute run-of-show cues, backstage management, and guest comfort so you remain an honored guest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Band -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading">Ready to Plan Your Next Grand Occasion?</h2>
      <p>
        Consult directly with our event directors to design a tailor-made celebration that will be remembered for years to come.
      </p>
      <div class="cta-actions">
        <a href="/enquiry" class="btn btn-primary btn-lg">
          <span>Start Your Enquiry</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 10H16M11 5L16 10L11 15" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/contact" class="btn btn-secondary btn-lg">
          <span>Contact Our Team</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
