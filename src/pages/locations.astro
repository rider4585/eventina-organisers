---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Event Locations Map | Eventina Organisers — Pan-India Luxury Venues"
  description="Explore the historic palaces, coastal sanctuaries, and metropolitan ballrooms across India where Eventina Organisers crafts bespoke weddings and luxury galas."
>
  <Fragment slot="head">
    <!-- Leaflet CSS loaded strictly on locations page -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  </Fragment>

  <!-- Page Hero Banner -->
  <section class="page-hero" aria-labelledby="locations-hero-title">
    <div class="container page-hero-inner">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li aria-current="page">Event Locations Map</li>
        </ol>
      </nav>

      <span class="eyebrow">Pan-India Heritage &amp; Contemporary Footprint</span>
      <h1 id="locations-hero-title" class="page-hero-title">
        Where Splendour Meets Geography
      </h1>
      <p class="page-hero-lead">
        From historic island palaces in Udaipur to sun-drenched coastal sanctuaries in Goa and palatial metropolitan ballrooms in Bengaluru, discover the curated destinations where Eventina crafts unforgettable celebrations.
      </p>
    </div>
  </section>

  <!-- Interactive Map Section -->
  <section class="section" aria-labelledby="map-section-title">
    <div class="container">
      <h2 id="map-section-title" class="sr-only">Interactive Destination Map and Venues Directory</h2>

      <!-- Toolbar: Filters, Status Count, Reset -->
      <div class="locations-toolbar">
        <div class="locations-filter-group" role="group" aria-label="Filter locations by region">
          <button type="button" class="locations-filter-btn is-active" data-filter="all" aria-pressed="true">
            All Regions
          </button>
          <button type="button" class="locations-filter-btn" data-filter="rajasthan" aria-pressed="false">
            Rajasthan Palaces
          </button>
          <button type="button" class="locations-filter-btn" data-filter="coastal" aria-pressed="false">
            Coastal &amp; Goa
          </button>
          <button type="button" class="locations-filter-btn" data-filter="metro" aria-pressed="false">
            Metropolitan Galas
          </button>
          <button type="button" class="locations-filter-btn" data-filter="hills" aria-pressed="false">
            Himalayan Retreats
          </button>
          <button type="button" class="locations-filter-btn" data-filter="south" aria-pressed="false">
            Southern Heritage
          </button>
        </div>

        <div class="locations-status-bar">
          <span class="locations-count-badge" id="locations-count">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Showing 10 Destinations</span>
          </span>
          <button type="button" class="map-reset-btn" id="map-reset-btn" aria-label="Reset map viewport to whole India">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            <span>Reset View</span>
          </button>
        </div>
      </div>

      <!-- Map Container Card -->
      <div class="locations-map-card">
        <div id="map-container" class="locations-map-viewport" role="region" aria-label="Interactive map of Eventina destinations across India">
          <!-- Leaflet Map Mount Point -->
        </div>
      </div>

      <!-- Venue Directory Grid (Accessible & Progressive Enhancement) -->
      <div class="section-header" style="margin-top: var(--space-8); margin-bottom: var(--space-6);">
        <span class="eyebrow">Curated Destination Directory</span>
        <h2 class="section-title" style="font-size: var(--text-3xl);">
          Explore Our Signature Host Venues
        </h2>
        <p class="section-lead" style="margin-inline: 0; max-width: 60ch;">
          Select any destination below to inspect its dedicated event photo gallery, technical parameters, and architectural highlights.
        </p>
      </div>

      <div class="locations-grid" id="locations-directory">

        <!-- Card 1: Udaipur -->
        <article class="location-card" data-region="rajasthan">
          <div class="location-card-media">
            <img
              src="https://images.unsplash.com/photo-1519741497674-611481863552?w=800&q=80&auto=format&fit=crop"
              alt="Jagmandir Island Palace dining court"
              class="location-card-img"
              width="800"
              height="500"
              loading="lazy"
            />
            <span class="location-card-tag">Rajasthan Palaces</span>
          </div>
          <div class="location-card-body">
            <div class="location-card-region">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Udaipur, Rajasthan</span>
            </div>
            <h3 class="location-card-title">Jagmandir Island Palace</h3>
            <p class="location-card-excerpt">
              Floating lake mandap scenography, royal flotilla guest arrival, and palatial marble court banquets.
            </p>
            <div class="location-card-footer">
              <span class="location-card-guest-count">Capacity: 450 Guests</span>
              <button type="button" class="location-card-btn" data-open-location="udaipur-jagmandir">
                <span>Explore Gallery</span>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
