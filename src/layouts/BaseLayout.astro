---
import 'lenis/dist/lenis.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/pages.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string | URL;
  type?: string;
}

const {
  title = 'Eventina Organisers | Bespoke Celebrations & Luxury Events',
  description = 'Premier event organisers in India crafting bespoke destination weddings, corporate galas, and milestone celebrations with artistic elegance and meticulous precision.',
  ogImage = 'https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&q=80&auto=format&fit=crop',
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://eventina.in'),
  type = 'website',
} = Astro.props;

const canonicalHref = typeof canonicalURL === 'string' ? canonicalURL : canonicalURL.href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FAF9F6" />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalHref} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Google Fonts Preconnect & Stylesheet (Cormorant Garamond + Josefin Sans + Plus Jakarta Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Josefin+Sans:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Favicon & Web Manifest -->
  <link rel="icon" type="image/svg+xml" href="/assets/img/icon-crest.svg" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Sitemap Discovery -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Speculation Rules API for instant SPA-feel navigation -->
  <script type="speculationrules">
  {
    "prefetch": [
      {
        "source": "list",
        "urls": ["/about", "/services", "/portfolio", "/events", "/blog", "/contact", "/enquiry"]
      }
    ]
  }
  </script>

  <!-- Page-Specific Head Injections (e.g. JSON-LD schema) -->
  <slot name="head" />
</head>
<body>
  <!-- Global Header Shell -->
  <Header currentPath={Astro.url.pathname} />

  <!-- Main Landmark -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Global Footer Shell -->
  <Footer />

  <!-- Global WhatsApp Concierge Floating CTA -->
  <WhatsAppButton />

  <!-- Lenis Smooth Scrolling & Luxury Scroll-Reveal Motion Engine -->
  <script>
    import Lenis from 'lenis';

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        touchMultiplier: 1.5,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      (window as any).lenis = lenis;

      // Handle internal anchor links smoothly with Lenis
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href !== '#' && document.querySelector(href)) {
            e.preventDefault();
            lenis.scrollTo(href, { offset: -80 });
          }
        });
      });
    }

    // Scroll-Reveal Animation Engine
    const initScrollReveal = () => {
      const revealElements = document.querySelectorAll(
        '.reveal-on-scroll, .section-header, .card, .portfolio-card, .service-card, .value-card, .stat-item, .faq-item, .about-stat-box, .pillar-card'
      );

      if (!('IntersectionObserver' in window) || prefersReducedMotion) {
        revealElements.forEach((el) => el.classList.add('is-revealed'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        },
        {
          rootMargin: '0px 0px -6% 0px',
          threshold: 0.1,
        }
      );

      revealElements.forEach((el) => {
        if (!el.classList.contains('is-revealed')) {
          el.classList.add('reveal-init');
          const parent = el.parentElement;
          if (parent && (parent.classList.contains('grid-2') || parent.classList.contains('grid-3') || parent.classList.contains('grid-4') || parent.classList.contains('portfolio-grid') || parent.classList.contains('stats-grid') || parent.classList.contains('about-stats-grid'))) {
            const siblingIndex = Array.from(parent.children).indexOf(el);
            (el as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(siblingIndex * 70, 350)}ms`);
          }
          observer.observe(el);
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollReveal);
    } else {
      initScrollReveal();
    }

    document.addEventListener('astro:page-load', initScrollReveal);
  </script>
</body>
</html>
